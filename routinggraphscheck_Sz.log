[ [ 1, 2, 3 ], [ 1, 2, 15 ] ]
gap> List(L,x->Size(Stabilizer(G,x,OnSets)));
[ 1, 2 ]
gap> for set in L do
>    check:=RoutingGraphsCheck(G,[[1],[2],[3]],set,[1,2]); 
