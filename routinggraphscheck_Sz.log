gap> SetInfoLevel(TRANSVERSALPROPERTIES_info,0);
gap> TRANSVERSALPROPERTIES_tpexternal_maxnum:=0; # so external C program is not used
0
gap> G:=AllPrimitiveGroups(NrMovedPoints,65,Transitivity,2);
[ PSU(3, 4), PSU(3, 4).2, PGammaU(3, 4), PSz(8), PSz(8).3 ]
gap> G:=G[4];
PSz(8)
gap> UniversalTransversalProperty(G,3);
true
gap> Runtime(); # CPU-time in milliseconds spent by GAP so far.
1952
gap> L:=LeastSetRepresentatives(G,3);
[ [ 1, 2, 3 ], [ 1, 2, 15 ] ]
gap> List(L,x->Size(Stabilizer(G,x,OnSets)));
[ 1, 2 ]
gap> for A in L do
>    check:=RoutingGraphsCheck(G,[[1],[2],[3]],A,[1,2]); 
>    Print("\n",A,"  ",check,"\n");
> od;

[ 1, 2, 3 ]  true

[ 1, 2, 15 ]  true
